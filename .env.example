# Leave every key empty to run in demo mode (rule-based notes, no API calls).

# Groq (free tier): answers, re-ranking, and Whisper for audio uploads and live meetings
GROQ_API_KEY=

# Or Claude
ANTHROPIC_API_KEY=

# Or use Gemini (free tier available)
# MINUTES_PROVIDER=gemini
# GEMINI_API_KEY=
# MINUTES_GEMINI_MODEL=gemini-3.5-flash

# Optional overrides
MINUTES_MODEL=claude-opus-5-5
MINUTES_DB_PATH=data/minutes.db
MINUTES_CHUNK_WORDS=160
MINUTES_RETRIEVAL_K=8
MINUTES_CORS_ORIGINS=http://localhost:5173
